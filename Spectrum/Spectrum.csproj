  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <UsingTask TaskName="PrepareSpectrumRelease" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <OutputDirectory ParameterType="System.String" Required="true" />
      <OverviewFile ParameterType="System.String" Required="true" />
      <PackageNotices ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <RetiredFiles ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        var output = Path.GetFullPath(OutputDirectory);
        var encoding = new UTF8Encoding(false);
        using (var combined = new MemoryStream())
        {
            var overview = File.ReadAllBytes(OverviewFile);
            combined.Write(overview, 0, overview.Length);
            foreach (var notice in PackageNotices)
            {
                var source = notice.GetMetadata("FullPath");
                var package = new DirectoryInfo(Path.GetDirectoryName(source)).Name;
                var separator = encoding.GetBytes(
                    "\r\n\r\n---\r\n\r\n## Bundled package aggregate: " + package + "\r\n\r\n");
                combined.Write(separator, 0, separator.Length);
                var payload = File.ReadAllBytes(source);
                combined.Write(payload, 0, payload.Length);
            }
            File.WriteAllBytes(Path.Combine(output, "THIRD_PARTY_NOTICES.md"), combined.ToArray());
        }

        // Only retire the exact documentation artifacts previously owned by this project.
        foreach (var notice in PackageNotices)
        {
            var relative = notice.GetMetadata("Link");
            var legacy = Path.GetFullPath(Path.Combine(output, relative));
            if (!legacy.StartsWith(output.TrimEnd(Path.DirectorySeparatorChar) +
                Path.DirectorySeparatorChar, StringComparison.OrdinalIgnoreCase))
                throw new InvalidOperationException("A legacy notice must remain inside the output directory.");
            var packageDirectory = Path.GetDirectoryName(legacy);
            var assemblyName = new DirectoryInfo(packageDirectory).Name;
            File.Delete(Path.Combine(output, assemblyName + ".xml"));
            if (File.Exists(legacy))
                File.Delete(legacy);
            if (Directory.Exists(packageDirectory) && Directory.GetFileSystemEntries(packageDirectory).Length == 0)
                Directory.Delete(packageDirectory);
        }
        foreach (var retired in RetiredFiles)
        {
            var legacy = Path.GetFullPath(Path.Combine(output, retired.ItemSpec));
            if (!legacy.StartsWith(output.TrimEnd(Path.DirectorySeparatorChar) +
                Path.DirectorySeparatorChar, StringComparison.OrdinalIgnoreCase))
                throw new InvalidOperationException("A retired file must remain inside the output directory.");
            if (File.Exists(legacy))
                File.Delete(legacy);
        }
        var retiredPackage = Path.Combine(output, "ThirdParty", "System.Configuration.ConfigurationManager");
        if (Directory.Exists(retiredPackage) && Directory.GetFileSystemEntries(retiredPackage).Length == 0)
            Directory.Delete(retiredPackage);
        var thirdParty = Path.Combine(output, "ThirdParty");
        if (Directory.Exists(thirdParty) && Directory.GetFileSystemEntries(thirdParty).Length == 0)
            Directory.Delete(thirdParty);
      ]]></Code>
    </Task>
  </UsingTask>
  <Target Name="PrepareReleaseDistribution" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
