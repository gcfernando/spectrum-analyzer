<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8"/>
	</startup>
	<appSettings>
		<clear/>
		<!-- Mode and Theme are startup defaults; saved per-user preferences take precedence. -->
		<!-- Visual modes are presentation-only and use the existing analyzed band levels. -->
		<!-- Valid modes: Spectrum, Bricks, LED, Dots, Wave, Lollipop, Waterfall, Radial Spectrum, Contour, -->
		<!-- Peak Trace, Threshold Monitor, Band Matrix, Octave Spectrum, Level Change, Orbit History, -->
		<!-- Octave Waterfall, Level Change Map, and Frequency Ribbon. -->

		<!-- DEFAULT RECOMMENDATION: Use "Spectrum" for all-around best performance - works perfectly with any music genre, real-time response, beautiful and accurate -->
		<add key="Mode" value="Bricks"/>
		<!-- Optional visual style. None is safe for every mode; unsupported combinations resolve to None. -->
		<add key="Style" value="None"/>

		<!-- Color Themes: Choose the bar color palette (independent of Mode, which controls shape/animation) -->
		<!-- ClassicSmooth:	Green -> yellow -> orange, red peak - Best for: traditional VU/spectrum look, all-around default -->
		<!-- Ice:		Deep blue -> cyan -> white, icy peak - Best for: cool, calm, minimal/ambient aesthetics -->
		<!-- Sunset:		Dark amber -> orange -> red, pale gold peak - Best for: warm, vibrant, sunset-inspired visuals -->
		<!-- MonoCyan:	Single-hue cyan, brightness-graded, pale cyan peak - Best for: clean, modern, monochrome/studio look -->
		<!-- Synthwave:	Purple -> magenta -> pink, electric-cyan peak - Best for: 80s retro, synthwave, neon party visuals -->
		<!-- Aurora:	Deep teal -> emerald -> cyan, pale violet peak - an independent palette for any mode -->
		<!-- Obsidian Gold: Dark gold -> radiant gold -> pale gold peak - Best for: premium, classic display warmth -->
		<!-- Midnight Prism: Violet -> electric cyan -> cool-white peak - Best for: high-contrast nocturnal neon -->
		<!-- Emerald Noir: Deep emerald -> vivid jade -> mint-white peak - Best for: luxurious green-on-black contrast -->
		<!-- Crimson Velvet: Dark crimson -> rose -> blush peak - Best for: rich, dramatic warm contrast -->

		<!-- DEFAULT RECOMMENDATION: Use "ClassicSmooth" for the familiar, high-contrast heat-map look -->
		<add key="Theme" value="ClassicSmooth"/>
	</appSettings>
</configuration>